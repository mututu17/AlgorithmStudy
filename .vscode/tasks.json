{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build C++",
            "type": "shell",
            "command": "g++.exe",
            "args": [
                "-g",
                "\"${file}\"", 
                "-o",
                "\"${fileDirname}\\${fileBasenameNoExtension}.exe\""
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": ["$msCompile"],
            "detail": "컴파일러를 사용하여 C++ 파일을 빌드합니다."
        },
        {
            "label": "Run C++",
            "type": "shell",
            "command": "\"${workspaceFolder}\\${fileBasenameNoExtension}.exe\"",
            "group": {
                "kind": "test",
                "isDefault": true
            },
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared",
                "showReuseMessage": true,
                "clear": false
            },
            "problemMatcher": []
        }
    ]
}